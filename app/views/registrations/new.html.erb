<h1>Sign up</h1>

<%= form_with(model: @user, url: signup_path) do |form| %>
  <% if @user.errors.any? %>
    <div class="errors">
      <% @user.errors.full_messages.each do |message| %>
        <p><%= message %></p>
        <% end %>
    </div>
  <% end %>
  <div><%= form.text_field :username, placeholder: "Username", required: true %></div>
  <div><%= form.email_field :email_address, placeholder: "Email", required: true %></div>
  <div><%= form.password_field :password, placeholder: "Password", required: true %></div>
  <div><%= form.password_field :password_confirmation, placeholder: "Confirm Password", required: true %></div>
  <div><%= form.submit "Sign up" %></div>
<% end %>
